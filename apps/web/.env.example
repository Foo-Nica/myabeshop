# API base URL, as seen from the browser
NEXT_PUBLIC_API_URL=http://localhost:4000
# API base URL, as seen from the Next.js server (same as above unless running in Docker)
API_INTERNAL_URL=http://localhost:4000
# Root domain for store subdomains (maboutique.ROOT_DOMAIN). In local dev stores live at /s/<slug>.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
