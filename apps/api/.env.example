DATABASE_URL=postgresql://myabe:myabe@localhost:5432/myabeshop
PORT=4000
JWT_SECRET=change-me-in-production-please-32chars
# Public URL of the web app (storefronts and dashboard)
WEB_URL=http://localhost:3000
# Root domain used for store subdomains (maboutique.ROOT_DOMAIN)
ROOT_DOMAIN=localhost:3000
# Public URL of this API (used to build uploaded image URLs)
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# In development, OTP codes are logged and returned by the API. Never enable in production.
OTP_DEV_ECHO=true

# ---------- Phase « Paiements OK » ----------
# Payment gateway: "simulator" (local page to approve/decline) or "fedapay".
PAYMENT_GATEWAY=simulator
FEDAPAY_ENV=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
# Background jobs (SMS, WhatsApp, Google Sheets). Without it, jobs run in-process.
REDIS_URL=
# Key used to encrypt integration settings (defaults to a hash of JWT_SECRET).
INTEGRATIONS_KEY=
# Phone of the first super-admin, created/flagged by `pnpm db:seed`.
SUPER_ADMIN_PHONE=
# Seller shown on invoices.
BILLING_SELLER_NAME=Nicanor KSH Solutions (NKS) — Myabéshop
BILLING_SELLER_ADDRESS=Calavi-Zogbadjè, Cotonou, Bénin
BILLING_SELLER_EMAIL=facturation@myabeshop.com
